# Copy to .env and edit. Real environment variables (e.g. Replit Secrets) override this file.

# Login password for the web UI. Leave empty to have one generated and stored for you.
VNC_PASSWORD=

# Set to 1 to disable the Origin / CSRF checks (embedded or non-browser clients).
#ALLOW_CROSS_SITE=1

# Where to listen. Replit sets 0.0.0.0 automatically; elsewhere the default is 127.0.0.1.
#HOST=0.0.0.0
#PORT=6080

# Virtual screen size (WxH or WxHxDepth).
#RESOLUTION=1280x720x24

# Discord release channel: ptb (default), stable, canary
#DISCORD_CHANNEL=ptb

# Audio
#AUDIO=1
#AUDIO_FORMAT=mp3
#AUDIO_BITRATE=96
